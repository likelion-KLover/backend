{
  "index_patterns": [
    "commpostchs"
  ],
  "template": {
    "settings": {
      "index" : {
        "max_ngram_diff": 10
      },
      "analysis": {
        "char_filter": {
          "remove_korean": {
            "type": "pattern_replace",
            "pattern": "[ㄱ-ㅎ가-힣]",
            "replacement": ""
          },
          "remove_symbols": {
            "type": "pattern_replace",
            "pattern": "[\\p{P}\\p{S}\\s]",
            "replacement": ""
          }
        },
        "analyzer": {
          "chs_content_search_analyzer": {
            "type": "custom",
            "tokenizer": "ik_smart",
            "char_filter": [
              "remove_korean"
            ],
            "filter": [
              "cjk_width",
              "content_pinyin",
              "asciifolding"
            ]
          },
          "chs_word_search_analyzer": {
            "type": "custom",
            "tokenizer": "keyword",
            "char_filter": [
              "remove_korean",
              "remove_symbols"
            ],
            "filter": [
              "cjk_width",
              "ngram_filter",
              "word_pinyin",
              "asciifolding",
              "unique"
            ]
          },
          "chs_word_analyzer": {
            "type": "custom",
            "tokenizer": "ik_smart",
            "char_filter": [
              "remove_korean"
            ],
            "filter": [
              "cjk_width",
              "my_pinyin",
              "asciifolding"
            ]
          }
        },
        "filter": {
          "ngram_filter": {
            "type": "ngram",
            "min_gram": 2,
            "max_gram": 4
          },
          "my_pinyin": {
            "type": "pinyin",
            "keep_first_letter": false,
            "keep_separate_first_letter": false,
            "keep_full_pinyin": true,
            "keep_original": false,
            "keep_joined_full_pinyin": false,
            "limit_first_letter_length": 0,
            "lowercase": true
          },
          "content_pinyin": {
            "type": "pinyin",
            "keep_first_letter": false,
            "keep_separate_first_letter": false,
            "keep_full_pinyin": false,
            "keep_original": false,
            "keep_joined_full_pinyin": true,
            "limit_first_letter_length": 0,
            "lowercase": true
          },
          "word_pinyin": {
            "type": "pinyin",
            "keep_first_letter": false,
            "keep_separate_first_letter": false,
            "keep_full_pinyin": true,
            "keep_original": false,
            "keep_joined_full_pinyin": true,
            "limit_first_letter_length": 0,
            "lowercase": true
          },
          "han_to_latin": {
            "type": "icu_transform",
            "id": "Han-Latin"
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "id": {
          "type": "long"
        },
        "member_id": {
          "type": "long"
        },
        "content": {
          "type": "text",
          "analyzer": "chs_content_search_analyzer"
        },
        "create_date": {
          "type": "date",
          "format": "strict_date_time"
        },
        "modify_date": {
          "type": "date",
          "format": "strict_date_time"
        },
        "location": {
          "type": "geo_point"
        },
        "nickname": {
          "type": "text",
          "analyzer": "chs_word_analyzer",
          "fields": {
            "ngram": {
              "type": "text",
              "analyzer": "chs_word_search_analyzer"
            }
          }
        },
        "comment_count": {
          "type": "long"
        },
        "like_count": {
          "type": "long"
        },
        "language": {
          "type": "keyword"
        },
        "image_urls": {
          "type": "keyword"
        }
      }
    }
  }
}
