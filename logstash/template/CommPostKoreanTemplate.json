{
  "index_patterns": [
    "commpostkor*"
  ],
  "template": {
    "settings": {
      "index" : {
        "max_ngram_diff": 10
      },
      "analysis": {
        "char_filter": {
          "remove_symbols": {
            "type": "pattern_replace",
            "pattern": "[\\p{P}\\p{S}\\s]",
            "replacement": ""
          }
        },
        "tokenizer": {
          "nori_mixed": {
            "type": "nori_tokenizer",
            "decompound_mode": "mixed"
          },
          "nori_none": {
            "type": "nori_tokenizer",
            "decompound_mode": "none"
          }
        },
        "analyzer": {
          "korean_mixed": {
            "type": "custom",
            "tokenizer": "nori_mixed",
            "filter": [
              "nori_readingform",
              "nori_part_of_speech"
            ]
          },
          "korean_word": {
            "type": "custom",
            "tokenizer": "nori_mixed",
            "filter": [
              "nori_readingform",
              "nori_stoptags"
            ]
          },
          "korean_partial": {
            "type": "custom",
            "tokenizer": "keyword",
            "char_filter": [
              "remove_symbols"
            ],
            "filter": [
              "ngram_filter",
              "unique"
            ]
          }
        },
        "filter": {
          "ngram_filter":{
            "type": "ngram",
            "min_gram": 2,
            "max_gram": 5
          },
          "nori_stoptags": {
            "type": "nori_part_of_speech",
            "stoptags": ["SP"]
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "id": {
          "type": "long"
        },
        "member_id": {
          "type": "long"
        },
        "content": {
          "type": "text",
          "analyzer": "korean_mixed"
        },
        "create_date": {
          "type": "date",
          "format": "strict_date_time"
        },
        "modify_date": {
          "type": "date",
          "format": "strict_date_time"
        },
        "location": {
          "type": "geo_point"
        },
        "nickname": {
          "type": "text",
          "analyzer": "korean_word",
          "fields": {
            "ngram": {
              "type": "text",
              "analyzer": "korean_partial"
            }
          }
        },
        "comment_count": {
          "type": "long"
        },
        "like_count": {
          "type": "long"
        },
        "language": {
          "type": "keyword"
        },
        "image_urls": {
          "type": "keyword"
        }
      }
    }
  }
}
