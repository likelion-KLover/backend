{
  "index_patterns": ["tourpostjpn*"],
  "template": {
    "settings": {
      "index" : {
        "max_ngram_diff": 10
      },
      "analysis": {
        "char_filter": {
          "remove_korean": {
            "type": "pattern_replace",
            "pattern": "[ㄱ-ㅎ가-힣]",
            "replacement": ""
          },
          "remove_symbols":{
            "type": "pattern_replace",
            "pattern": "[\\p{P}\\p{S}\\s]",
            "replacement": ""
          }
        },
        "tokenizer": {
          "kuromoji_search_tokenizer": {
            "type": "kuromoji_tokenizer",
            "mode": "search",
            "user_dictionary": "userdict_ja.txt",
            "discard_compound_token": false,
            "lenient": true
          },
          "kuromoji_word_tokenizer": {
            "type": "kuromoji_tokenizer",
            "mode": "normal",
            "user_dictionary": "userdict_ja.txt",
            "discard_compound_token": false,
            "lenient": true
          }
        },
        "analyzer": {
          "japanese_content_romaji_search": {
            "type": "custom",
            "tokenizer": "kuromoji_search_tokenizer",
            "char_filter": [
              "remove_korean"
            ],
            "filter": [
              "cjk_width",
              "kuromoji_baseform",
              "ja_stop",
              "kuromoji_part_of_speech",
              "kuromoji_number",
              "kuromoji_stemmer",
              "katakana_filter",
              "romaji_filter",
              "asciifolding",
              "lowercase"
            ]
          },
          "japanese_simple_word_romaji": {
            "type": "custom",
            "tokenizer": "kuromoji_search_tokenizer",
            "char_filter": [
              "remove_korean",
              "remove_symbols"
            ],
            "filter": [
              "cjk_width",
              "kuromoji_number",
              "kuromoji_stoptags",
              "katakana_filter",
              "katakana_to_latin",
              "asciifolding",
              "lowercase"
            ]
          },
          "japanese_word_romaji_search": {
            "type": "custom",
            "tokenizer": "kuromoji_word_tokenizer",
            "char_filter": [
              "remove_korean"
            ],
            "filter": [
              "cjk_width",
              "kuromoji_number",
              "kuromoji_stoptags",
              "katakana_filter",
              "big_ngram",
              "katakana_to_latin",
              "asciifolding",
              "lowercase"
            ]
          },
          "keyword_analyzer": {
            "type": "custom",
            "tokenizer": "kuromoji_word_tokenizer",
            "char_filter": [
              "remove_korean"
            ],
            "filter": [
              "cjk_width",
              "katakana_filter",
              "katakana_to_latin",
              "asciifolding",
              "lowercase"
            ]
          }
        },
        "filter": {
          "big_ngram": {
            "type": "ngram",
            "min_gram": 2,
            "max_gram": 6
          },
          "romaji_filter": {
            "type": "kuromoji_readingform",
            "use_romaji": true
          },
          "katakana_filter": {
            "type": "kuromoji_readingform",
            "use_romaji": false
          },
          "any_to_katakana": {
            "type": "icu_transform",
            "id":"Any-Katakana"
          }
          ,
          "katakana_to_latin": {
            "type": "icu_transform",
            "id": "Katakana-Latin"
          },
          "kuromoji_stoptags": {
            "type": "kuromoji_part_of_speech",
            "stoptags": ["記号"]
          },
          "remove_whitespace_filter": {
            "type": "pattern_replace",
            "pattern": "\\s+",
            "replacement": ""
          },
          "remove_accented_chars": {
            "type": "pattern_replace",
            "pattern": "[̀́̂̄̇]",
            "replacement": ""
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "content_id": {
          "type": "long"
        },
        "common_place_id": {
          "type": "long"
        },
        "first_image": {
          "type": "keyword"
        },
        "addr1": {
          "type": "keyword"
        },
        "title": {
          "type": "text",
          "analyzer": "japanese_simple_word_romaji",
          "fields": {
            "ngram": {
              "type": "text",
              "analyzer": "japanese_word_romaji_search"
            }
          }
        },
        "overview": {
          "type": "text",
          "analyzer": "japanese_content_romaji_search"
        },
        "location": {
          "type": "geo_point"
        },
        "create_date": {
          "type": "date",
          "format": "strict_date_time"
        },
        "cat1": {
          "type": "keyword"
        },
        "cat2": {
          "type": "keyword"
        },
        "cat3": {
          "type": "keyword"
        },
        "content_type_id": {
          "type": "long"
        },
        "area_code": {
          "type": "long"
        },
        "review_count": {
          "type": "long"
        },
        "rating_average": {
          "type": "scaled_float",
          "scaling_factor": 10
        },
        "language": {
          "type": "keyword"
        }
      }
    }
  }
}
